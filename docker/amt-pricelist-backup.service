[Unit]
Description=AMT Price List scheduled backup job
After=network-online.target podman.service amt-pricelist.service
Wants=network-online.target

[Service]
Environment="DOCKER_HOST=unix:///run/podman/podman.sock"
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/shop-pricelist/current/scripts/deployment/manage.py backup-job --yes
TimeoutStartSec=1800
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
CPUQuota=50%
MemoryMax=1G
