# Add only this location inside the existing TLS server block for the chosen domain.
# Replace the placeholder upstream. Prefer 127.0.0.1:<saved-port>; if the VPS
# loopback publish is unhealthy, use the current app container IP on port 3000.
server {
    listen 443 ssl;
    server_name price.example.com;
    ssl_certificate /etc/letsencrypt/live/price.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/price.example.com/privkey.pem;
    client_max_body_size 21m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location /amt_price_list/ {
        proxy_pass http://127.0.0.1:18180;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
}
