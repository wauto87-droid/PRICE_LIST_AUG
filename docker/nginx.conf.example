# Add a NEW site only after a domain and certificate have been supplied.
# Replace price.example.com, certificate paths, and the verified free port.
server {
    listen 443 ssl;
    server_name price.example.com;
    ssl_certificate /etc/letsencrypt/live/price.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/price.example.com/privkey.pem;
    client_max_body_size 21m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:18180;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
}
