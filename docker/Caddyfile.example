# Add only this host block through the existing Caddy configuration/import structure.
# Replace the placeholder domain and confirm the dedicated port before use.
# Do not replace the server's main Caddyfile. Validate the full config before reload.
prices.example.com {
    encode zstd gzip
    @amt_price_list path /amt_price_list /amt_price_list/*
    handle @amt_price_list {
        # Preserve the prefix: Next.js is built with this base path.
        reverse_proxy 127.0.0.1:18180
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
}
