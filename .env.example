# Copy to .env; generate secrets locally. Never commit real credentials.
DATABASE_URL=postgresql://amt:REPLACE_WITH_RANDOM_PASSWORD@db:5432/amt_pricelist
POSTGRES_DB=amt_pricelist
POSTGRES_USER=amt
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ORIGIN=http://localhost:18180
APP_PORT=18180
COOKIE_SECURE=false
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
PDF_MAX_PAGES=100
UPLOAD_MAX_MB=20
BACKUP_RETENTION_DAYS=14
# Local development only; never use in production.
# DEV_EMBEDDED_DB=true
