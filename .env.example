# Copy to .env; generate secrets locally. Never commit real credentials.
DATABASE_URL=postgresql://amt:REPLACE_WITH_RANDOM_PASSWORD@db:5432/amt_pricelist
POSTGRES_DB=amt_pricelist
POSTGRES_USER=amt
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AI_SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
OPENAI_PRODUCT_MODEL=gpt-5.4-nano
APP_ORIGIN=http://localhost:18180
APP_BASE_PATH=/amt_price_list
APP_PORT=18180
COOKIE_SECURE=false
# Online store providers (configure before enabling customer checkout)
PUBLIC_URL=http://localhost:18180/amt_price_list
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
PDF_MAX_PAGES=100
UPLOAD_MAX_MB=20
BACKUP_RETENTION_DAYS=14
# Local development only; never use in production.
# DEV_EMBEDDED_DB=true
